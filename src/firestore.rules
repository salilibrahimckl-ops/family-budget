rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function fam(fid) {
      return get(/databases/$(database)/documents/families/$(fid)).data;
    }
    function isMember(fid) {
      return request.auth != null && request.auth.uid in fam(fid).members;
    }

    match /families/{fid} {
      // Reading one family needs its (secret, random) id from the invite code.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);
      // Members can edit; a newcomer may only add themselves (join).
      allow update: if isMember(fid) || (
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'inboxTokens'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
      );
      allow delete: if false;

      // budgets, transactions, rules
      match /{sub}/{doc} {
        allow read, write: if sub != 'inbox' && isMember(fid);
      }

      // iPhone Shortcut drops bank SMS here without signing in.
      // The token in the path must be one of the family's inbox tokens.
      match /inbox/{token}/items/{item} {
        allow create: if token in fam(fid).inboxTokens
          && request.resource.data.keys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() < 2000;
        allow read, delete: if isMember(fid);
      }
    }
  }
}
